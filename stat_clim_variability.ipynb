    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The value of T for 95% confidence interval for sample A is 2.045229642132703\n",
      "The 95 % confidence interval for sample A using T distribution is 277.57178453194945 , 277.6769337297693\n",
      "The value of T for 95% confidence interval for sample B is 2.045229642132703\n",
      "The 95 % confidence interval for sample A using T distribution is 278.44633528529016 , 278.6599269217411\n"
     ]
    }
   ],
   "source": [
    "from scipy import stats\n",
    "# DETERMINING THE 95% CONFIDENCE INTERVAL USING T DISTRIBUTION FOR SAMPLE A\n",
    "n1 = len(ann_A)\n",
    "cf =0.025\n",
    "t_val_A = stats.t.ppf(1-cf,df=n1-1)                                                            # T Value\n",
    "print('The value of T for 95% confidence interval for sample A is',t_val)\n",
    "\n",
    "lb_A = mean_A-(t_val*std_A)/np.sqrt(len(ann_A))                                                # Lower bound for A\n",
    "ub_A = mean_A+(t_val*std_A)/np.sqrt(len(ann_A))                                                # Upper bound for A\n",
    "print('The 95 % confidence interval for sample A using T distribution is',lb_A.values,',',ub_A.values)\n",
    "# DETERMINING THE 95% CONFIDENCE INTERVAL USING T DISTRIBUTION FOR SAMPLE B\n",
    "n2 = len(ann_B)\n",
    "cf2 =0.025\n",
    "t_val_B = stats.t.ppf(1-cf2,df=n2-1)\n",
    "print('The value of T for 95% confidence interval for sample B is',t_val_B)\n",
    "\n",
    "lb_B = mean_B-(t_val*std_B)/np.sqrt(len(ann_B))                                                # Lower bound for B\n",
    "ub_B = mean_B+(t_val*std_B)/np.sqrt(len(ann_B))                                                 # Upper bound for B\n",
    "print('The 95 % confidence interval for sample A using T distribution is',lb_B.values,',',ub_B.values)"
   ]
